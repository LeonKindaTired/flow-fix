# Documentation only. Do not pass this file to `supabase secrets set --env-file`.
# Set production function secrets individually after reviewing each value.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
VISION_API_KEY=
VISION_PROVIDER=gemini
VISION_MODEL=gemini-3.1-flash-lite
VISION_TIMEOUT_MS=12000
DEMO_MODE=false
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
# Production default: Photon. Nominatim remains selectable but is not used in production.
GEOCODE_PROVIDER=photon
GEOCODE_RADIUS_M=50
APP_CONTACT=
DUPLICATE_RADIUS_METERS=20
VISION_CONFIDENCE_REVIEW_THRESHOLD=0.60
ENABLE_CORROBORATION=true
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081
MAX_REPORTS_PER_HOUR=20
NOMINATIM_TIMEOUT_MS=5000
